# ── Base Sepolia RPC ──────────────────────────────────────────────────────────
# Public fallback (rate-limited): https://sepolia.base.org
# Get a free key: https://www.alchemy.com or https://www.infura.io
RPC_URL=https://sepolia.base.org

# ── Test Safe ─────────────────────────────────────────────────────────────────
# Populated automatically by `pnpm deploy`. You can also set it manually if
# you already have a Safe and want to skip the deploy step.
# SAFE_ADDRESS=0x...

# ── Signer key (mandate signer + Safe owner) ──────────────────────────────────
# Signs EIP-712 mandates and is the sole owner of the 1-of-1 testnet Safe.
# Separate from executor for least-privilege.
# TESTNET ONLY — never use a key that controls real funds.
# SIGNER_PRIVATE_KEY=0x...

# ── Executor key (Roles Modifier caller) ──────────────────────────────────────
# This key calls execTransactionWithRole on the Roles Modifier.
# Scoped on-chain to USDC transfers to whitelisted addresses only.
# The LLM never sees or uses this key.
# TESTNET ONLY.
# EXECUTOR_PRIVATE_KEY=0x...

# ── Whitelist (comma-separated) ───────────────────────────────────────────────
# Addresses the executor is allowed to send USDC to.
# Set before running `pnpm deploy`.
# WHITELIST=0xabc...,0xdef...

# ── Per-tx cap in USDC base units (6 decimals) ───────────────────────────────
# Default: 1000000 = 1.000000 USDC
# Set before running `pnpm deploy`.
# PER_TX_CAP_BASE_UNITS=1000000

# ── LLM API key (Phase 4+) ────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
