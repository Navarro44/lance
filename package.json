{
  "name": "lance",
  "version": "0.1.0",
  "description": "Agentic Payment Authorization Layer — verifiable, LLM-safe stablecoin payments",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:chain": "vitest run tests/chain.test.ts",
    "lint": "eslint src scripts tests",
    "lint:fix": "eslint src scripts tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "check-connection": "tsx scripts/check-connection.ts",
    "deploy": "tsx scripts/deploy.ts",
    "live-payment": "tsx scripts/live-payment.ts"
  },
  "dependencies": {
    "@gnosis-guild/zodiac": "5.0.1",
    "@gnosis-guild/zodiac-core": "4.3.0",
    "@safe-global/protocol-kit": "^7.0.0",
    "dotenv": "^16.4.0",
    "viem": "^2.51.0",
    "zod": "^3.23.0",
    "zodiac-roles-sdk": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
